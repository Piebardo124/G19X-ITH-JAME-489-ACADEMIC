# Seguridad de Tokens
JWT_SECRET_KEY=

# Configuracion de Base de datos
DATABASE_URL=

# Configuracion de Azure OpenAI
# Para Azure OpenAI v1, incluye /openai/v1/ en el endpoint.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Configuración de Azure AI Language (ambas variables son necesarias para el análisis completo).
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_ALERT_RECIPIENT=
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FEEDBACK=5/minute
RATE_LIMIT_CSV_UPLOAD=3/minute
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_USER_URLENCODED=
POSTGRES_PASSWORD_URLENCODED=
POSTGRES_DB_URLENCODED=

